<Page x:Class="KingdomRushClone.Views.AssetPreviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Asset Preview" Background="#111827">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="#1F2937" LastChildFill="False">
            <Button Content="Back" Width="84" Height="32" Margin="10,8"
                    Click="OnBack" Background="#374151" Foreground="White" BorderThickness="0"/>
            <TextBlock Text="Asset Preview" Foreground="#F9FAFB" FontSize="20"
                       FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,18,0"/>
            <ComboBox x:Name="ChapterBox" Width="140" Height="30" Margin="0,8,12,8"
                      SelectionChanged="OnChapterChanged"/>
            <TextBlock x:Name="StatusText" Foreground="#CBD5E1" FontSize="12"
                       VerticalAlignment="Center" Margin="10,0"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PreviewHost" Margin="16"/>
        </ScrollViewer>
    </Grid>
</Page>
