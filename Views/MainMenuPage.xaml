<Page x:Class="KingdomRushClone.Views.MainMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Main Menu" Background="#0D1117">
    <Grid>
        <!-- 배경 장식: 대각선 스트라이프 패턴 -->
        <Grid.Background>
            <DrawingBrush TileMode="Tile" Viewport="0,0,60,60"
                          ViewportUnits="Absolute" Opacity="0.03">
                <DrawingBrush.Drawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Geometry>
                            <LineGeometry StartPoint="0,60" EndPoint="60,0"/>
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#00D4FF" Thickness="1.5"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 좌측 세로 장식 바 -->
        <StackPanel Grid.RowSpan="3" Orientation="Vertical" HorizontalAlignment="Left"
                    Width="4" Margin="0">
            <Rectangle Fill="#00D4FF" Height="120"/>
            <Rectangle Fill="#F59E0B" Height="40"/>
            <Rectangle Fill="#00D4FF" Opacity="0.3" Height="600"/>
        </StackPanel>

        <!-- 우측 세로 장식 바 -->
        <StackPanel Grid.RowSpan="3" Orientation="Vertical" HorizontalAlignment="Right"
                    Width="4" Margin="0">
            <Rectangle Fill="#00D4FF" Opacity="0.15" Height="400"/>
            <Rectangle Fill="#F59E0B" Height="30"/>
            <Rectangle Fill="#00D4FF" Opacity="0.15" Height="330"/>
        </StackPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Width="340">

            <!-- 타이틀 블록 -->
            <Border BorderBrush="#164E63" BorderThickness="0,0,0,1" Margin="0,0,0,32" Padding="0,0,0,20">
                <StackPanel>
                    <!-- 장르 라벨 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Rectangle Width="24" Height="1" Fill="#00D4FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="TOWER DEFENSE STRATEGY"
                                   Foreground="#00D4FF" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <Rectangle Width="24" Height="1" Fill="#00D4FF" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <!-- 메인 타이틀 -->
                    <TextBlock Text="TEAM" Foreground="#E5E7EB" FontSize="18"
                               FontWeight="Light" HorizontalAlignment="Center"
                               Margin="0,0,0,-6"/>
                    <TextBlock Text="TOWER DEFENSE"
                               Foreground="#00D4FF" FontSize="42" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text=".NET 8  ·  WPF  ·  C# 12"
                               Foreground="#4B5563" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 메뉴 버튼들 -->
            <Button x:Name="BtnStart" Height="52" FontSize="18" Margin="0,0,0,6"
                    Click="OnStart" Background="#0D2E0E">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="▶" Foreground="#10B981" FontSize="18"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="게임 시작" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="PLAY" Foreground="#4B5563" FontSize="10"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button x:Name="BtnTech" Height="44" FontSize="16" Margin="0,0,0,6"
                    Click="OnTech" Background="#111827">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="◈" Foreground="#F59E0B" FontSize="16"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="테크트리" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="PERMANENT UPGRADES" Foreground="#4B5563" FontSize="9"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button x:Name="BtnGuide" Height="44" FontSize="16" Margin="0,0,0,6"
                    Click="OnGuide" Background="#111827">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🏹" FontSize="16"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="타워 도감" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="OPERATOR CODEX" Foreground="#4B5563" FontSize="9"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button x:Name="BtnHelp" Height="38" FontSize="14" Margin="0,0,0,6"
                    Click="OnHelp" Background="#111827">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="?" Foreground="#9CA3AF" FontSize="16"
                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="도움말" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnExit" Height="38" FontSize="14" Margin="0,0,0,0"
                    Click="OnExit" Background="#2D0D05">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✕" Foreground="#EF4444" FontSize="14"
                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="종료" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 스탯 표시 -->
            <Border BorderBrush="#164E63" BorderThickness="0,1,0,0"
                    Margin="0,24,0,0" Padding="0,16,0,0">
                <TextBlock x:Name="StatsText" Foreground="#4B5563"
                           HorizontalAlignment="Center" FontSize="12"
                           FontFamily="Consolas"/>
            </Border>
        </StackPanel>
    </Grid>
</Page>
