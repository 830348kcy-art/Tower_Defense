<Page x:Class="KingdomRushClone.Views.TechTreePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Tech Tree" Background="#0D1117">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── 상단 헤더 바 ───────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Background="#0A0F1A">
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#164E63"/>
            <Rectangle Width="4" HorizontalAlignment="Left" Fill="#F59E0B"/>

            <DockPanel Margin="12,0" LastChildFill="False" VerticalAlignment="Center">
                <Button Content="◀  MAIN" Width="88" Height="34"
                        Click="OnBack" Background="#111827"
                        DockPanel.Dock="Left" Margin="0,0,12,0"/>
                <Rectangle Width="1" Fill="#164E63" Margin="0,6" DockPanel.Dock="Left"/>

                <StackPanel DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PERMANENT UPGRADES" Foreground="#F59E0B"
                               FontSize="9" FontWeight="Bold"/>
                    <TextBlock Text="테크트리 — 영구 강화" FontSize="20" FontWeight="Bold"
                               Foreground="#E5E7EB"/>
                </StackPanel>

                <!-- 별 표시 (우측) -->
                <Border DockPanel.Dock="Right" Background="#111827"
                        BorderBrush="#92400E" BorderThickness="1"
                        Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="★ 보유" Foreground="#F59E0B" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StarsText" Foreground="#F59E0B"
                                   FontSize="16" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Grid>

        <!-- ── 노드 패널 ──────────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16">
            <StackPanel x:Name="NodesPanel" Margin="4"/>
        </ScrollViewer>
    </Grid>
</Page>
