<Page x:Class="KingdomRushClone.Views.TowerGuidePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="타워 도감" Background="#0D1117">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── 상단 헤더 바 ───────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Background="#0A0F1A">
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#164E63"/>
            <Rectangle Width="4" HorizontalAlignment="Left" Fill="#0EA5E9"/>

            <DockPanel Margin="12,0" LastChildFill="False" VerticalAlignment="Center">
                <Button Content="◀  MAIN" Width="88" Height="34"
                        Click="OnBack" Background="#111827"
                        DockPanel.Dock="Left" Margin="0,0,12,0"/>
                <Rectangle Width="1" Fill="#164E63" Margin="0,6" DockPanel.Dock="Left"/>

                <StackPanel DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="OPERATOR CODEX" Foreground="#0EA5E9"
                               FontSize="9" FontWeight="Bold"/>
                    <TextBlock Text="타워 도감" FontSize="20" FontWeight="Bold"
                               Foreground="#E5E7EB"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Right" Text="각 타워의 역할과 업그레이드 경로를 확인하세요"
                           Foreground="#4B5563" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
            </DockPanel>
        </Grid>

        <!-- ── 좌: 타워 목록 / 우: 상세 ───────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 타워 목록 패널 -->
            <Border Grid.Column="0" Background="#111827"
                    BorderBrush="#164E63" BorderThickness="1"
                    Margin="0,0,12,0">
                <Grid>
                    <!-- 상단 라벨 -->
                    <Rectangle Height="32" VerticalAlignment="Top"
                               Fill="#0A0F1A"/>
                    <TextBlock Text="TOWERS" Foreground="#00D4FF"
                               FontSize="9" FontWeight="Bold"
                               VerticalAlignment="Top" HorizontalAlignment="Left"
                               Margin="12,10,0,0"/>
                    <Rectangle Width="4" HorizontalAlignment="Left" Fill="#00D4FF"/>

                    <StackPanel x:Name="TowerListPanel" Margin="0,32,0,0"/>
                </Grid>
            </Border>

            <!-- 상세 패널 -->
            <Border Grid.Column="1" Background="#111827"
                    BorderBrush="#164E63" BorderThickness="1">
                <Grid>
                    <Rectangle Height="32" VerticalAlignment="Top" Fill="#0A0F1A"/>
                    <TextBlock Text="DETAILS" Foreground="#0EA5E9"
                               FontSize="9" FontWeight="Bold"
                               VerticalAlignment="Top" HorizontalAlignment="Left"
                               Margin="12,10,0,0"/>
                    <Rectangle Width="4" HorizontalAlignment="Left" Fill="#0EA5E9"/>

                    <ScrollViewer Margin="0,32,0,0" VerticalScrollBarVisibility="Auto">
                        <Border Padding="20">
                            <StackPanel x:Name="DetailPanel"/>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
