<Page x:Class="KingdomRushClone.Views.StageSelectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Stage Select" Background="#0D1117">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── 상단 헤더 바 ───────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Background="#0A0F1A">
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#164E63"/>
            <Rectangle Width="4" HorizontalAlignment="Left" Fill="#00D4FF"/>

            <DockPanel Margin="12,0" LastChildFill="False" VerticalAlignment="Center">
                <Button Content="◀  MAIN" Width="88" Height="34"
                        Click="OnBack" Background="#111827"
                        DockPanel.Dock="Left" Margin="0,0,12,0"/>
                <Rectangle Width="1" Fill="#164E63" Margin="0,6" DockPanel.Dock="Left"/>

                <StackPanel DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="OPERATION SELECT" Foreground="#00D4FF"
                               FontSize="9" FontWeight="Bold"/>
                    <TextBlock Text="스테이지 선택" FontSize="20" FontWeight="Bold"
                               Foreground="#E5E7EB"/>
                </StackPanel>

                <!-- 별 표시 (우측) -->
                <Border DockPanel.Dock="Right" Background="#111827"
                        BorderBrush="#164E63" BorderThickness="1"
                        Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="★" Foreground="#F59E0B" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StarsText" Foreground="#E5E7EB"
                                   FontSize="14" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Grid>

        <!-- ── 스테이지 그리드 ──────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Margin="16">
            <WrapPanel x:Name="StagesPanel" Margin="4"/>
        </ScrollViewer>
    </Grid>
</Page>
