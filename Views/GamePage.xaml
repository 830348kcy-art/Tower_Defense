<Page x:Class="KingdomRushClone.Views.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Game" Background="#0D1117"
      Focusable="True" KeyDown="OnKey">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- ══ HUD TOP ════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Background="#0A0F1A">
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#164E63"/>
            <Rectangle Width="4" HorizontalAlignment="Left" Fill="#00D4FF"/>

            <DockPanel Margin="8,0" LastChildFill="False" VerticalAlignment="Center">
                <Button Content="◀  MENU" Width="88" Height="32"
                        Click="OnExit" Margin="0,0,8,0"
                        Background="#111827" DockPanel.Dock="Left"/>

                <Rectangle Width="1" Fill="#164E63" Margin="0,6" DockPanel.Dock="Left"/>

                <!-- 스테이지 이름 -->
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                            DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="STAGE" Foreground="#4B5563" FontSize="9" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="StageText" Foreground="#00D4FF" FontSize="14"
                               FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <Rectangle Width="1" Fill="#164E63" Margin="12,6" DockPanel.Dock="Left"/>

                <!-- 골드 -->
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                            DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="◈" Foreground="#F59E0B" FontSize="15"
                               Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GoldText" Foreground="#F59E0B" FontSize="14"
                               FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <Rectangle Width="1" Fill="#164E63" Margin="10,6" DockPanel.Dock="Left"/>

                <!-- 라이프 -->
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                            DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="♥" Foreground="#EF4444" FontSize="14"
                               Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LivesText" Foreground="#EF4444" FontSize="14"
                               FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <Rectangle Width="1" Fill="#164E63" Margin="10,6" DockPanel.Dock="Left"/>

                <!-- 웨이브 -->
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                            DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="WAVE" Foreground="#4B5563" FontSize="9" FontWeight="Bold"
                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WaveText" Foreground="#E5E7EB" FontSize="14"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 우측 컨트롤 -->
                <Button x:Name="SpeedBtn" Content="1×" Width="56" Height="32"
                        Click="OnSpeed" Background="#1C2333"
                        Margin="6,0" DockPanel.Dock="Right"/>
                <Button x:Name="PauseBtn" Content="⏸  PAUSE" Width="96" Height="32"
                        Click="OnPause" Background="#1C2333"
                        Margin="6,0" DockPanel.Dock="Right"/>
            </DockPanel>
        </Grid>

        <!-- ══ GAME AREA ════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <!-- 캔버스 영역 -->
            <Border>
                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,40,40"
                                  ViewportUnits="Absolute" Opacity="0.05">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="40,0"  EndPoint="40,40"/>
                                        <LineGeometry StartPoint="0,40"  EndPoint="40,40"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#00D4FF" Thickness="0.6"/>
                                </GeometryDrawing.Pen>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
                <Canvas x:Name="GameCanvas" Width="1100" Height="620"
                        Background="Transparent" ClipToBounds="True"
                        MouseLeftButtonDown="OnCanvasClick"/>
            </Border>

            <!-- ── Boss HP Panel (좌상단 전술 카드) ──────────────────────── -->
            <Border x:Name="BossHealthPanel" Width="276" Margin="14,14,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="#CC0A0F1A" BorderBrush="#00D4FF" BorderThickness="1"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <Grid>
                    <!-- 좌측 액센트 블록 -->
                    <Rectangle Width="4" HorizontalAlignment="Left" Fill="#00D4FF"/>
                    <StackPanel Margin="12,8,8,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="TARGET ▸" Foreground="#00D4FF" FontSize="9"
                                       FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="BossHealthName" Foreground="#F59E0B"
                                       FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                        <!-- HP 바 세그먼트 스타일 -->
                        <Grid Width="236" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4">
                            <Rectangle Fill="#0D1117"/>
                            <Rectangle x:Name="BossHealthFill" Width="236" Fill="#EF4444"
                                       HorizontalAlignment="Left"/>
                            <Path Data="M47,0 L47,10 M94,0 L94,10 M141,0 L141,10 M188,0 L188,10"
                                  Stroke="#0D1117" StrokeThickness="2" Opacity="0.7"/>
                        </Grid>
                        <TextBlock x:Name="BossHealthText" Foreground="#9CA3AF"
                                   FontSize="11" FontFamily="Consolas"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── 라이프 플래시 ──────────────────────────────────────────── -->
            <Border x:Name="LivesFlashBorder"
                    BorderBrush="#CCEF4444" BorderThickness="12"
                    IsHitTestVisible="False" Visibility="Collapsed" Opacity="0"/>

            <!-- ── 웨이브 배너 ─────────────────────────────────────────────── -->
            <Grid x:Name="AnnounceOverlay"
                  IsHitTestVisible="False" Visibility="Collapsed"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,58,0,0">
                <Border Background="#E50A0F1A" BorderBrush="#00D4FF"
                        BorderThickness="0,1,0,1" Padding="52,10">
                    <Grid>
                        <Path HorizontalAlignment="Left" Margin="-20,0,0,0" VerticalAlignment="Center"
                              Data="M0,0 L18,14 L0,28 Z" Fill="#00D4FF" Opacity="0.7"/>
                        <Path HorizontalAlignment="Right" Margin="0,0,-20,0" VerticalAlignment="Center"
                              Data="M18,0 L0,14 L18,28 Z" Fill="#00D4FF" Opacity="0.7"/>
                        <TextBlock x:Name="AnnounceText"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="#00D4FF"
                                   HorizontalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ══ BOTTOM BAR ════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Background="#0A0F1A">
            <Rectangle Height="1" VerticalAlignment="Top" Fill="#164E63"/>
            <Rectangle Width="4" HorizontalAlignment="Right" Fill="#00D4FF" Opacity="0.4"/>

            <DockPanel Margin="8,0" LastChildFill="False" VerticalAlignment="Center">
                <!-- 다음 웨이브 버튼 -->
                <Button x:Name="CallWaveBtn" Content="▶  NEXT WAVE  [N]"
                        Width="176" Height="42"
                        Click="OnCallWave" Background="#0D2E0E"
                        DockPanel.Dock="Left" Margin="0,0,4,0"/>

                <!-- 타이머 + 미리보기 -->
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left"
                            VerticalAlignment="Center" Margin="8,0,4,0">
                    <TextBlock x:Name="NextWaveTimer"   Foreground="#9CA3AF"
                               FontSize="11" FontFamily="Consolas"/>
                    <TextBlock x:Name="NextWavePreview" Foreground="#0EA5E9" FontSize="11"/>
                </StackPanel>

                <Rectangle Width="1" Fill="#164E63" Margin="8,6" DockPanel.Dock="Left"/>

                <!-- 화포 스킬 버튼 -->
                <Button x:Name="MeteorBtn" Width="154" Height="42"
                        Click="OnMeteor" Background="#2D0D05"
                        DockPanel.Dock="Left" Margin="0,0,4,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Margin="4,0">
                            <TextBlock Text="🔥" FontSize="18" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="화  포" FontSize="12" FontWeight="Bold" Foreground="#E5E7EB"/>
                                <TextBlock Text="[1]  METEOR" FontSize="9" Foreground="#9CA3AF"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- 쿨다운 셰이드 -->
                        <Border x:Name="MeteorCdShade" Background="#CC0A0F1A" Visibility="Collapsed"
                                Margin="-12,0,-8,0">
                            <TextBlock x:Name="MeteorCdText" Foreground="#F59E0B" FontSize="18"
                                       FontWeight="Bold" FontFamily="Consolas"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Button>

                <!-- 지원군 스킬 버튼 -->
                <Button x:Name="ReinforceBtn" Width="154" Height="42"
                        Click="OnReinforce" Background="#0D1A2D"
                        DockPanel.Dock="Left" Margin="0,0,4,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Margin="4,0">
                            <TextBlock Text="🛡" FontSize="18" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="지원군" FontSize="12" FontWeight="Bold" Foreground="#E5E7EB"/>
                                <TextBlock Text="[2]  SUPPORT" FontSize="9" Foreground="#9CA3AF"/>
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="ReinforceCdShade" Background="#CC0A0F1A" Visibility="Collapsed"
                                Margin="-12,0,-8,0">
                            <TextBlock x:Name="ReinforceCdText" Foreground="#00D4FF" FontSize="18"
                                       FontWeight="Bold" FontFamily="Consolas"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Button>

                <!-- 힌트 (우측) -->
                <TextBlock x:Name="HintText" Foreground="#F59E0B" FontSize="12"
                           VerticalAlignment="Center" Margin="16,0"
                           DockPanel.Dock="Right"/>
            </DockPanel>
        </Grid>

        <!-- ══ OVERLAY (건설/업그레이드/결과) ════════════════════════════════ -->
        <Grid x:Name="Overlay" Grid.Row="1" Background="#AA0D1117" Visibility="Collapsed">
            <ContentControl x:Name="OverlayContent"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
